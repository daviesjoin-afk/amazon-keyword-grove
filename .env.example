# Optional local database override. The default is backend/data/keyword-grove.db.
KEYWORD_DB_PATH=backend/data/keyword-grove.db

# Optional frontend API override for a non-default backend host.
VITE_API_BASE_URL=http://127.0.0.1:8765/api

# MiMo credentials are configured in the local UI under 工作台 > AI 语义设置.
# Never commit a real API key to this file or to the repository.
